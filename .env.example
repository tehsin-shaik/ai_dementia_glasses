# Application
APP_ENV=development

# Backend
API_HOST=127.0.0.1
API_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional AI image understanding
# Leave these blank to keep the manual-only workflow.
# VISION_PROVIDER is openai or gemini.
VISION_PROVIDER=
VISION_MODEL=
VISION_API_KEY=

# Database
DATABASE_URL=

# Hosted demo (see docs/DEPLOY.md)
# Extra browser origins allowed to call the API, comma separated.
ALLOWED_ORIGINS=
# Set to 1 so a deployment with an empty database seeds the demo profiles.
SEED_ON_STARTUP=

# Local media
MEDIA_DIR=./data/media
# Set to database to keep uploaded photos in DATABASE_URL instead of MEDIA_DIR.
MEDIA_STORAGE=
# Hours an unsaved capture is kept before cleanup (whole number, at least 24).
# Reviewed and saved data never expires.
OBSERVATION_RETENTION_HOURS=168

# Conservative proactive context cues
CUE_SCHEDULE_LOOKAHEAD_MINUTES=30
CUE_COOLDOWN_MINUTES=20
CUE_RECOGNITION_WINDOW_MINUTES=10
CUE_OBJECT_LOOKBACK_MINUTES=30
